# All values are public. They are set in Cloudflare Pages at build time.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=https://api.pmservers.org
# Shown on the AI page. Default: NEXT_PUBLIC_API_URL + /ai/v1
# NEXT_PUBLIC_AI_URL=https://api.pmservers.org/ai/v1
# 1 starts the MSW mock API in the browser
NEXT_PUBLIC_API_MOCK=1
# 1 skips Supabase and uses a fake user. For local work and previews only.
NEXT_PUBLIC_AUTH_MOCK=1
